<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WanderLust | Error</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
      body {
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: "Plus Jakarta Sans", sans-serif;
        background: #fff5f5;
      }
      .err-box {
        text-align: center;
      }
      .err-box h1 {
        font-size: 4rem;
        color: #e74c3c;
      }
    </style>
  </head>
  <body>
    <div class="err-box">
      <h1><i class="bi bi-emoji-frown"></i> Oops!</h1>
      <h3><%= message %></h3>
      <a href="/listings" class="btn btn-outline-danger mt-3">Back to Listings</a>
    </div>
  </body>
</html>
