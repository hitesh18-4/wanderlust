<% layout("layouts/boilerplate") %>
<div class="row">
  <div class="col-12 col-md-5 offset-md-3 auth-box">
    <h2 class="form-heading mb-4 text-center">Sign up</h2>
    <form method="POST" action="/signup" class="needs-validation" novalidate>
      <div class="mb-3">
        <label class="form-label" for="username">Username</label>
        <input
          type="text"
          name="username"
          id="username"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please choose a username.</div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="email">Email address</label>
        <input
          type="email"
          name="email"
          id="email"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please enter a valid email.</div>
      </div>

      <div class="mb-3">
        <label class="form-label" for="password">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          class="form-control"
          required
        />
        <div class="invalid-feedback">Please enter a password.</div>
      </div>

      <button class="btn submit-btn w-100 mt-2">Sign up</button>
    </form>
    <p class="mt-3 text-center">
      Already have an account? <a href="/login">Log in</a>
    </p>
  </div>
</div>
