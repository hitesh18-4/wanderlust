# MongoDB connection string.
# Local dev (make sure `mongod` is running):
#   mongodb://127.0.0.1:27017/wanderlust
# Or a MongoDB Atlas connection string:
#   mongodb+srv://<user>:<password>@<cluster-url>/wanderlust?retryWrites=true&w=majority
ATLASDB_URL=mongodb://127.0.0.1:27017/wanderlust

# Used to sign session cookies + encrypt the session store. Use any long random string.
SECRET=wanderlustsupersecretcode

# Cloudinary (free tier works fine) -> https://cloudinary.com/console
# Used to store uploaded listing images.
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_api_key
CLOUD_API_SECRET=your_api_secret

# Mapbox public token -> https://account.mapbox.com/access-tokens/
# Used to geocode listing locations and render the map on the show page.
MAP_TOKEN=your_mapbox_token

PORT=8080
